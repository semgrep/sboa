; sboa.frozen: the PyImport_FrozenModules table of an application, i.e.
; the bundle importer (python/_sboa_importer.py) and the stdlib
; `encodings` package that interpreter start-up needs, marshalled into
; frozen.c by the bundle tool's `freeze` subcommand.
;
; frozen.c defines strong sboa_frozen_table/sboa_frozen_magic, which
; override the weak empty ones of sboa.cpython (src/cpython/frozen_stub.c).
; A library archive member is only linked when something references it, so
; frozen_anchor.c (which #includes frozen.c) also defines a primitive that
; Sboa_frozen calls at module initialization; with -linkall that forces the
; object, and hence the strong table, into every executable linking this
; library. (Linking frozen.c as an object of the executable itself would also
; work, but dune rejects foreign stubs in executables built in bytecode mode.)

(library
 (name sboa_frozen)
 (public_name sboa.frozen)
 (libraries sboa)
 (modules sboa_frozen)
 (library_flags (-linkall))
 (foreign_stubs
  (language c)
  (names frozen_anchor)
  (flags
   (:standard
    (:include cflags.sexp)))
  (extra_deps frozen.c)))

; frozen.c includes Python.h: same -I as sboa.cpython.

(rule
 (copy ../src/cpython/cflags.sexp cflags.sexp))

(rule
 (targets frozen.c)
 (action
  (run
   sh
   %{dep:../probe.sh}
   --exec-python
   -I
   %{dep:../tools/sboa_bundle.py}
   --config
   %{dep:../toolchain/sboa.config}
   freeze
   --module
   _sboa_importer=%{dep:../python/_sboa_importer.py}
   --stdlib-package
   encodings
   --out
   frozen.c)))
