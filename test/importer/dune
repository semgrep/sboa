; End-to-end check of the start-up path with the real bundle tooling: a
; frozen table holding _pyembed_importer (strong symbols overriding
; pyembed's weak empty table) and a bundle zip embedded with .incbin, both
; generated by tools/pyembed_bundle.py. pyembed's init must install the
; importer over _pyembed.bundles(), and refuse empty or truncated bundles.
; The stdlib still comes from extra_sys_path (no stdlib bundle here).

(rule
 (copy ../../src/cpython/cflags.sexp cflags.sexp))

(rule
 (deps
  ../../src/cpython/cflags.sexp
  ../../toolchain/cpython-embed.config
  (env_var PYEMBED_PREFIX)
  (env_var PYEMBED_CONFIG))
 (action
  (with-stdout-to
   stdlib_dir
   (run sh %{dep:../../probe.sh} --print-stdlib))))

(rule
 (targets frozen.c)
 (deps
  ../../src/cpython/cflags.sexp
  ../../toolchain/cpython-embed.config
  (:tool ../../tools/pyembed_bundle.py)
  (:importer ../../python/_pyembed_importer.py)
  (env_var PYEMBED_PREFIX)
  (env_var PYEMBED_CONFIG)
  (env_var PYEMBED_PYTHON))
 (action
  (run
   sh
   %{dep:../../probe.sh}
   --exec-python
   -I
   %{tool}
   freeze
   --module
   _pyembed_importer=%{importer}
   --out
   %{targets})))

(rule
 (targets demo_bundle.ml demo_bundle.zip demo_bundle_blob.c)
 (deps
  ../../src/cpython/cflags.sexp
  ../../toolchain/cpython-embed.config
  (:tool ../../tools/pyembed_bundle.py)
  (source_tree demopkg)
  (env_var PYEMBED_PREFIX)
  (env_var PYEMBED_CONFIG)
  (env_var PYEMBED_PYTHON))
 (action
  (run
   sh
   %{dep:../../probe.sh}
   --exec-python
   -I
   %{tool}
   bundle
   --name
   demo
   --package
   demopkg=demopkg
   --out
   .
   --base
   demo_bundle)))

(executable
 (name importer_prog)
 (modules importer_prog demo_bundle)
 (libraries pyembed pyembed.cpython)
 (foreign_stubs
  (language c)
  (names demo_bundle_blob frozen)
  (flags
   (:standard
    (:include cflags.sexp)))
  (extra_deps demo_bundle.zip)))

(rule
 (alias runtest)
 (deps stdlib_dir)
 (action
  (setenv
   PYEMBED_STDLIB
   %{read-lines:stdlib_dir}
   (progn
    (run %{exe:importer_prog.exe} ok)
    (run %{exe:importer_prog.exe} empty)
    (run %{exe:importer_prog.exe} truncated)))))
