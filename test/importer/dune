; End-to-end check of the start-up path with the real bundle tooling: a
; frozen table holding _sboa_importer (strong symbols overriding
; sboa's weak empty table) and a bundle zip embedded with .incbin, both
; generated by sboa-bundle. sboa's init must install the importer over
; _sboa.bundles(), and refuse empty or truncated bundles. The stdlib still
; comes from extra_sys_path (no stdlib bundle here).

(rule
 (copy ../../tools/link.sexp link.sexp))

(rule
 (with-stdout-to
  stdlib_dir
  (run
   %{bin:sboa-bundle}
   exec
   --config
   %{dep:../../tools/sboa.config}
   --
   -I
   -c
   "import sysconfig; print(sysconfig.get_path('stdlib'))")))

(rule
 (targets frozen.c)
 (action
  (run
   %{bin:sboa-bundle}
   --config
   %{dep:../../tools/sboa.config}
   freeze
   --module
   _sboa_importer=%{dep:../../python/_sboa_importer.py}
   --out
   %{targets})))

(rule
 (targets demo_bundle.ml demo_bundle.zip demo_bundle_blob.c)
 (deps
  (source_tree demopkg))
 (action
  (run
   %{bin:sboa-bundle}
   --config
   %{dep:../../tools/sboa.config}
   bundle
   --name
   demo
   --package
   demopkg=demopkg
   --out
   .
   --base
   demo_bundle)))

(executable
 (name importer_prog)
 (modules importer_prog demo_bundle)
 (libraries sboa)
 (link_flags
  (:include link.sexp))
 (foreign_stubs
  (language c)
  (names demo_bundle_blob frozen)
  (extra_deps demo_bundle.zip)))

(rule
 (alias runtest)
 (deps stdlib_dir)
 (action
  (setenv
   SBOA_STDLIB
   %{read-lines:stdlib_dir}
   (progn
    (run %{exe:importer_prog.exe} ok)
    (run %{exe:importer_prog.exe} empty)
    (run %{exe:importer_prog.exe} truncated)))))
