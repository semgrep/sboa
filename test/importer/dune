; End-to-end check of the start-up path with the real bundle tooling: a
; frozen table holding _sboa_importer (strong symbols overriding
; sboa's weak empty table) and a bundle zip embedded with .incbin, both
; generated by tools/sboa_bundle.py. sboa's init must install the
; importer over _sboa.bundles(), and refuse empty or truncated bundles.
; The stdlib still comes from extra_sys_path (no stdlib bundle here).

(rule
 (copy ../../src/cpython/cflags.sexp cflags.sexp))

(rule
 (deps
  ../../src/cpython/cflags.sexp
  ../../toolchain/sboa.config
  (env_var SBOA_CONFIG))
 (action
  (with-stdout-to
   stdlib_dir
   (run sh %{dep:../../probe.sh} --print-stdlib))))

(rule
 (targets frozen.c)
 (deps
  ../../src/cpython/cflags.sexp
  ../../toolchain/sboa.config
  (:tool ../../tools/sboa_bundle.py)
  (:importer ../../python/_sboa_importer.py)
  (env_var SBOA_CONFIG)
  (env_var SBOA_PYTHON))
 (action
  (run
   sh
   %{dep:../../probe.sh}
   --exec-python
   -I
   %{tool}
   freeze
   --module
   _sboa_importer=%{importer}
   --out
   %{targets})))

(rule
 (targets demo_bundle.ml demo_bundle.zip demo_bundle_blob.c)
 (deps
  ../../src/cpython/cflags.sexp
  ../../toolchain/sboa.config
  (:tool ../../tools/sboa_bundle.py)
  (source_tree demopkg)
  (env_var SBOA_CONFIG)
  (env_var SBOA_PYTHON))
 (action
  (run
   sh
   %{dep:../../probe.sh}
   --exec-python
   -I
   %{tool}
   bundle
   --name
   demo
   --package
   demopkg=demopkg
   --out
   .
   --base
   demo_bundle)))

(executable
 (name importer_prog)
 (modules importer_prog demo_bundle)
 (libraries sboa sboa.cpython sboa.toolchain)
 (foreign_stubs
  (language c)
  (names demo_bundle_blob frozen)
  (flags
   (:standard
    (:include cflags.sexp)))
  (extra_deps demo_bundle.zip)))

(rule
 (alias runtest)
 (deps stdlib_dir)
 (action
  (setenv
   SBOA_STDLIB
   %{read-lines:stdlib_dir}
   (progn
    (run %{exe:importer_prog.exe} ok)
    (run %{exe:importer_prog.exe} empty)
    (run %{exe:importer_prog.exe} truncated)
    (run %{exe:importer_prog.exe} dynload)))))
