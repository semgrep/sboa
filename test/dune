; Tests for sboa. `make test` runs them; so does any @runtest that reaches
; this directory. The CPython they use is the one sboa was built against
; (../tools/sboa.config); they link it with ../tools/link.sexp. The tests
; have no stdlib bundle: they put the stdlib directory (SBOA_STDLIB) on
; sys.path (recipe/ is the test with the bundles an application builds).

(rule
 (copy ../tools/cflags.sexp cflags.sexp))

(rule
 (copy ../tools/link.sexp link.sexp))

(rule
 (with-stdout-to
  stdlib_dir
  (run
   %{bin:sboa-bundle}
   exec
   --config
   %{dep:../tools/sboa.config}
   --
   -I
   -c
   "import sysconfig; print(sysconfig.get_path('stdlib'))")))

; A real frozen table (strong symbols overriding sboa's weak empty
; table), produced by the bundle tool's `freeze` subcommand.

(rule
 (targets frozen.c)
 (action
  (run
   %{bin:sboa-bundle}
   --config
   %{dep:../tools/sboa.config}
   freeze
   --module
   _sboa_frozen_probe=%{dep:frozen_probe.py}
   --out
   %{targets})))

; Not on Windows yet: the suite hangs there (seen in CI after the importer
; and disabled suites passed; the fork, signal and thread scenarios are the
; suspects). Follow-up: make it run on Windows.

(test
 (name test_sboa)
 (enabled_if
  (<> %{os_type} Win32))
 (modules test_sboa)
 (libraries sboa alcotest threads.posix unix)
 (link_flags
  (:include link.sexp))
 (foreign_stubs
  (language c)
  (names test_blob frozen)
  (flags
   (:standard
    "-DSBOA_TEST_PAYLOAD=\"%{dep:bundle_payload.bin}\""
    (:include cflags.sexp)))
  (extra_deps bundle_payload.bin))
 (deps exit_prog.exe stdlib_dir)
 (action
  (setenv
   SBOA_STDLIB
   %{read-lines:stdlib_dir}
   (run %{test} --color=never))))

(executable
 (name exit_prog)
 (modules exit_prog)
 (link_flags
  (:include link.sexp))
 (libraries sboa unix))
