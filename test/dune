; Tests for sboa. `make test` runs them; so does any
; @runtest that reaches this directory. The CPython they use is the one
; sboa.cpython links (probe.sh: ../toolchain/sboa.config, or
; SBOA_CONFIG; SBOA_PYTHON overrides the interpreter
; that compiles the test's frozen table). The tests have no stdlib bundle:
; they put the stdlib directory (SBOA_STDLIB) on sys.path.
;
; ../src/cpython/cflags.sexp stands for "the CPython in use" in the deps
; below: it is regenerated when the toolchain config changes.

(rule
 (copy ../src/cpython/cflags.sexp cflags.sexp))

(rule
 (deps
  ../src/cpython/cflags.sexp
  ../toolchain/sboa.config
  (env_var SBOA_CONFIG))
 (action
  (with-stdout-to
   stdlib_dir
   (run sh %{dep:../probe.sh} --print-stdlib))))

; A real frozen table (strong symbols overriding sboa's weak empty
; table), produced by the bundle tool's `freeze` subcommand.

(rule
 (targets frozen.c)
 (deps
  ../src/cpython/cflags.sexp
  ../toolchain/sboa.config
  (:tool ../tools/sboa_bundle.py)
  (:probe frozen_probe.py)
  (env_var SBOA_CONFIG)
  (env_var SBOA_PYTHON))
 (action
  (run
   sh
   %{dep:../probe.sh}
   --exec-python
   -I
   %{tool}
   freeze
   --module
   _sboa_frozen_probe=%{probe}
   --out
   %{targets})))

(test
 (name test_sboa)
 (modules test_sboa)
 (libraries sboa sboa.cpython alcotest threads.posix unix)
 (foreign_stubs
  (language c)
  (names test_blob frozen)
  (flags
   (:standard
    "-DSBOA_TEST_PAYLOAD=\"%{dep:bundle_payload.bin}\""
    (:include cflags.sexp)))
  (extra_deps bundle_payload.bin))
 (deps exit_prog.exe stdlib_dir)
 (action
  (setenv
   SBOA_STDLIB
   %{read-lines:stdlib_dir}
   (run %{test} --color=never))))

(executable
 (name exit_prog)
 (modules exit_prog)
 (libraries sboa sboa.cpython unix))

(test
 (name test_disabled)
 (modules test_disabled)
 (libraries sboa sboa.disabled alcotest))
