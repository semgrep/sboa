; Smoke test of `sboa_bundle.py runtime-files`, which stages the runtime
; files listed in sboa.config into a directory target that an application
; installs next to its executables (see ../README.md for the stanzas): stage
; this platform's layout (an empty directory target is an error, so only the
; layout of the platform is ever built; applications' install stanzas carry
; the same enabled_if).

(rule
 (enabled_if
  (<> %{os_type} Win32))
 (targets
  (dir staged))
 (deps ../toolchain/sboa.config ../probe.sh)
 (action
  (run
   sh
   ../probe.sh
   --exec-python
   -I
   %{dep:../tools/sboa_bundle.py}
   --config
   ../toolchain/sboa.config
   runtime-files
   --layout
   libs
   --out
   staged)))

(rule
 (enabled_if
  (= %{os_type} Win32))
 (targets
  (dir staged))
 (deps ../toolchain/sboa.config ../probe.sh)
 (action
  (run
   sh
   ../probe.sh
   --exec-python
   -I
   %{dep:../tools/sboa_bundle.py}
   --config
   ../toolchain/sboa.config
   runtime-files
   --layout
   bin
   --out
   staged)))

(rule
 (alias runtest)
 (deps staged)
 (action
  (echo "runtime files staged\n")))
