; gen_runtime_files.py stages the runtime files listed in sboa.config into a
; directory target, which an application installs next to its executables;
; see ../README.md for the stanzas. Installed into lib/sboa/ (%{lib:sboa:gen_runtime_files.py}).

(install
 (section lib)
 (package sboa)
 (files gen_runtime_files.py))

; Smoke test: stage this platform's layout (an empty directory target is an
; error, so only the layout of the platform is ever built; applications'
; install stanzas carry the same enabled_if).

(rule
 (enabled_if
  (<> %{os_type} Win32))
 (targets
  (dir staged))
 (deps ../toolchain/sboa.config ../probe.sh)
 (action
  (run
   sh
   ../probe.sh
   --exec-python
   -I
   %{dep:gen_runtime_files.py}
   ../toolchain/sboa.config
   --layout
   libs
   --out
   staged)))

(rule
 (enabled_if
  (= %{os_type} Win32))
 (targets
  (dir staged))
 (deps ../toolchain/sboa.config ../probe.sh)
 (action
  (run
   sh
   ../probe.sh
   --exec-python
   -I
   %{dep:gen_runtime_files.py}
   ../toolchain/sboa.config
   --layout
   bin
   --out
   staged)))

(rule
 (alias runtest)
 (deps staged)
 (action
  (echo "runtime files staged\n")))
