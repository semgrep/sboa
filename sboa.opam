# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Embed CPython in an OCaml executable"
description:
  "sboa (Sand Boa) links a CPython 3.13 shared library into an OCaml program and exposes a small, explicit bridge: a GIL token, owned Python object handles with deferred reference release, fallible typed conversions, OCaml functions and classes exported as builtin Python modules, and exception translation in both directions. The sboa-bundle tool builds what an application ships with it: the frozen-module table, the embedded standard library and application bundles, the runtime files. sboa never downloads CPython: it finds an installed CPython 3.13 with a shared libpython at build time (SBOA_PYTHON, SBOA_PREFIX, python3.13 on PATH, `uv python find 3.13`, or a python3 that is 3.13)."
maintainer: ["Semgrep Inc. <support@semgrep.com>"]
authors: ["Semgrep Inc."]
license: "LGPL-2.1-only"
homepage: "https://github.com/semgrep/sboa"
bug-reports: "https://github.com/semgrep/sboa/issues"
depends: [
  "dune" {>= "3.5"}
  "ocaml" {>= "5.3"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/semgrep/sboa.git"
# The CPython 3.13 headers and shared libpython sboa builds against, where
# the OS packages a 3.13 (elsewhere: `uv python install 3.13`, or
# SBOA_PREFIX; see README.md).
depexts: [
  ["python3.13-dev"] {os-distribution = "debian" & os-version >= "13"}
  ["python3.13-dev"] {os-distribution = "ubuntu" & os-version >= "25.04"}
  ["python3-dev"] {os-distribution = "alpine"}
  ["python3.13-devel"] {os-family = "fedora"}
  ["python"] {os-family = "arch"}
  ["python@3.13"] {os = "macos" & os-distribution = "homebrew"}
]
