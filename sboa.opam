# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Embed CPython in an OCaml executable"
description:
  "sboa (Sand Boa) links a CPython 3.13 shared library into an OCaml program and exposes a small, explicit bridge: a GIL token, owned Python object handles with deferred reference release, fallible typed conversions, OCaml functions and classes exported as builtin Python modules, and exception translation in both directions. The library is a dune virtual library with two implementations: sboa.cpython (the real bridge) and sboa.disabled (raises Sboa.Not_available, for executables that must not carry Python); sboa.stdlib compiles the standard library into the executable and sboa.frozen holds the frozen bundle importer. sboa never downloads CPython: an installed CPython 3.13 with a shared libpython must be provided at build time (SBOA_PREFIX=<installation prefix>, SBOA_PYTHON=<interpreter>, or python3.13 on PATH)."
maintainer: ["Semgrep Inc. <support@semgrep.com>"]
authors: ["Semgrep Inc."]
license: "LGPL-2.1-only"
homepage: "https://github.com/semgrep/sboa"
bug-reports: "https://github.com/semgrep/sboa/issues"
depends: [
  "dune" {>= "3.5"}
  "ocaml" {>= "5.3"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/semgrep/sboa.git"
