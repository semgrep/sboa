; The CPython that sboa builds against. sboa never downloads it: it must be
; installed already, and find_python.sh locates it (SBOA_PYTHON, SBOA_PREFIX,
; then python3.13 / python3 on PATH). describe.py, run under that
; interpreter, writes sboa.config (paths, version, link library, the runtime
; files an application ships; see ../README.md) and the data module of
; sboa.toolchain. Every rule that needs CPython (sboa.cpython's link flags,
; the stdlib bundle, the frozen table, applications' bundles) depends on
; sboa.config, which is installed next to probe.sh and sboa_bundle.py.
;
; The config records the interpreter's sys.version and libpython's size and
; mtime (install_fingerprint), and the globs below track the prefix's
; interpreter and libpython, so an upgraded installation re-runs the rule
; and everything downstream.
;
; (sandbox none): the outputs record absolute paths of the CPython
; installation and depend on the environment; user rules are not stored in
; dune's shared cache by default (keep it that way).

(rule
 (targets sboa.config sboa_toolchain_data.ml)
 (deps
  find_python.sh
  describe.py
  (env_var SBOA_PREFIX)
  (env_var SBOA_PYTHON)
  (env_var SBOA_MAGIC)
  (glob_files %{env:SBOA_PREFIX=/nonexistent}/bin/python3*)
  (glob_files %{env:SBOA_PREFIX=/nonexistent}/lib/libpython3*)
  (sandbox none))
 (action
  (run sh find_python.sh .)))

(install
 (section lib)
 (package sboa)
 (files sboa.config))

; sboa.toolchain: facts about the CPython an executable was built against
; (see sboa_toolchain.mli).

(library
 (name sboa_toolchain)
 (public_name sboa.toolchain)
 (modules sboa_toolchain sboa_toolchain_data)
 (private_modules sboa_toolchain_data))
