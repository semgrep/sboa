opam-version: "2.0"
version: "3.13.16"
synopsis: "CPython runtime for embedding, selected per platform"
description: """
Umbrella package: depends on exactly one cpython-embed-<platform> child chosen
by the os / os-distribution / arch filters. The child installs a CPython 3.13
runtime (python-build-standalone) under lib/cpython-embed/ together with a
findlib META and cpython-embed.config, which dune reads with
%{lib:cpython-embed:cpython-embed.config}."""
maintainer: ["Semgrep, Inc."]
authors: ["Python Software Foundation" "python-build-standalone contributors"]
license: "Python-2.0"
homepage: "https://github.com/astral-sh/python-build-standalone"
bug-reports: "https://github.com/semgrep/semgrep/issues"
dev-repo: "git+https://github.com/semgrep/semgrep.git"
depends: [
  "cpython-embed-linux-gnu-x86_64" {= version & os = "linux" & os-distribution != "alpine" & arch = "x86_64"}
  "cpython-embed-linux-gnu-aarch64" {= version & os = "linux" & os-distribution != "alpine" & arch = "arm64"}
  "cpython-embed-linux-musl-x86_64" {= version & os = "linux" & os-distribution = "alpine" & arch = "x86_64"}
  "cpython-embed-linux-musl-aarch64" {= version & os = "linux" & os-distribution = "alpine" & arch = "arm64"}
  "cpython-embed-macos-x86_64" {= version & os = "macos" & arch = "x86_64"}
  "cpython-embed-macos-arm64" {= version & os = "macos" & arch = "arm64"}
  "cpython-embed-windows-x86_64" {= version & os = "win32" & arch = "x86_64"}
]
