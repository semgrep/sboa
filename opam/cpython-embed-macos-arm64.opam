opam-version: "2.0"
version: "3.13.16"
synopsis: "CPython 3.13.16 runtime for embedding (macos-arm64)"
description: """
Platform child of cpython-embed: the pinned python-build-standalone
20261009 `install_only_stripped` distribution for aarch64-apple-darwin, verified by sha256
and installed under lib/cpython-embed/ (headers, shared library, stdlib,
cpython-embed.config). Select it through the cpython-embed umbrella package
rather than installing it directly."""
maintainer: ["Semgrep, Inc."]
authors: ["Python Software Foundation" "python-build-standalone contributors"]
license: "Python-2.0"
homepage: "https://github.com/astral-sh/python-build-standalone"
bug-reports: "https://github.com/semgrep/semgrep/issues"
dev-repo: "git+https://github.com/semgrep/semgrep.git"
available: [os = "macos" & arch = "arm64"]
conflicts: ["cpython-embed-linux-gnu-x86_64" "cpython-embed-linux-gnu-aarch64" "cpython-embed-linux-musl-x86_64" "cpython-embed-linux-musl-aarch64" "cpython-embed-macos-x86_64" "cpython-embed-windows-x86_64"]
build: [
  ["sh" "./install.sh" "macos-arm64" "./python-build-standalone.tar.gz" "./stage/cpython-embed" "%{lib}%/cpython-embed"]
]
url {
  src: "https://github.com/astral-sh/python-build-standalone/releases/download/20261009/cpython-3.13.16%2B20261009-aarch64-apple-darwin-install_only_stripped.tar.gz"
  checksum: "sha256=11785155d0f70e634178219c20925d8f20be00a3da4684fc4f5019dd15602ef7"
}
extra-source "python-build-standalone.tar.gz" {
  src: "https://github.com/astral-sh/python-build-standalone/releases/download/20261009/cpython-3.13.16%2B20261009-aarch64-apple-darwin-install_only_stripped.tar.gz"
  checksum: "sha256=11785155d0f70e634178219c20925d8f20be00a3da4684fc4f5019dd15602ef7"
}
