; The sboa virtual library. All logic lives in [Sboa] (sboa.ml);
; the virtual module [Backend] is the primitive layer, implemented by
; sboa.cpython (C stubs against Python.h) and sboa.disabled (raises
; Sboa.Not_available).

(library
 (name sboa)
 (public_name sboa)
 (virtual_modules backend)
 (libraries threads.posix unix))
