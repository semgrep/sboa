; The sboa library. All logic lives in [Sboa] (sboa.ml); [Backend] is the
; primitive layer: C stubs against Python.h (sboa_runtime.c, sboa_object.c,
; sboa_export.c), compiled against the headers of the CPython found by
; `sboa-bundle discover` (../tools/dune). The library carries no libpython link flags (except
; the import library on Windows, bound by DLL name): an
; application links the CPython it ships (README.md, "Linking libpython").

(library
 (name sboa)
 (public_name sboa)
 ; threads.posix: the stubs use the systhreads master lock
 ; (caml_enter/leave_blocking_section with several systhreads) and
 ; pthread_atfork; unix: Unix._exit in Sboa.exit.
 (libraries threads.posix unix)
 (foreign_stubs
  (language c)
  (names sboa_runtime sboa_object sboa_export frozen_stub)
  ; gcc/clang flags (mingw-w64 gcc on Windows); MSVC is not supported.
  (flags
   (:standard
    -std=c99
    -D_GNU_SOURCE
    -Wall
    -Wextra
    -Wno-unused-parameter
    (:include cflags.sexp))))
 ; empty except on Windows (../tools/dune)
 (c_library_flags
  (:include clibs.sexp)))

(rule
 (copy ../tools/cflags.sexp cflags.sexp))

(rule
 (copy ../tools/clibs.sexp clibs.sexp))
