; The CPython 3.13 sboa builds against, found by discover.ml (SBOA_PYTHON,
; SBOA_PREFIX, python3.13 on PATH, `uv python find`, python3 if it is 3.13;
; see ../README.md). It writes:
;
;   sboa.config      the installation (paths, version, the runtime files an
;                    application ships), installed into lib/sboa/
;   cflags.sexp      -I of the headers, for the library's C stubs
;   link.sexp        libpython and rpaths, for sboa's own test executables
;                    only: the library carries no libpython link flags, an
;                    application links the CPython it ships
;   clibs.sexp       the library's c_library_flags: empty, except the import
;                    library on Windows (bound by DLL name, not path)
;   build_python.ml  the interpreter, for the sboa-bundle launcher
;
; The config records the interpreter's sys.version and libpython's size and
; mtime, and the globs below track the prefix's interpreter and libpython, so
; an upgraded installation re-runs the rule and everything downstream.
;
; (sandbox none): the outputs record absolute paths of the CPython
; installation and depend on the environment; user rules are not stored in
; dune's shared cache by default (keep it that way).

(executable
 (name discover)
 (modules discover)
 (libraries dune-configurator))

(rule
 (targets sboa.config cflags.sexp link.sexp clibs.sexp build_python.ml)
 (deps
  (:tool ../tools/sboa_bundle.py)
  (env_var SBOA_PREFIX)
  (env_var SBOA_PYTHON)
  (env_var UV_PYTHON_INSTALL_DIR)
  (glob_files %{env:SBOA_PREFIX=/nonexistent}/bin/python3*)
  (glob_files %{env:SBOA_PREFIX=/nonexistent}/lib/libpython3*)
  (sandbox none))
 (action
  (run %{exe:discover.exe} -tool %{tool})))

(install
 (section lib)
 (package sboa)
 (files sboa.config))
