; sboa.stdlib: the standard library of the CPython built against (../toolchain),
; compiled to bytecode and embedded in the executable (.incbin). The
; generated Stdlib_bundle module registers it at priority 0: the stdlib is
; searched before every application bundle, so third-party code cannot shadow
; a stdlib module (the bundle tool also refuses stdlib top-level names in
; other bundles). -linkall: nothing references Stdlib_bundle, so its
; registration side effect would otherwise be dropped at link time.
;
; The stdlib tree is not a dune dependency: it only changes when the toolchain
; rule runs again, which rewrites sboa.config (a dependency).

(library
 (name sboa_stdlib)
 (public_name sboa.stdlib)
 (libraries sboa)
 (modules stdlib_bundle)
 (library_flags (-linkall))
 (foreign_stubs
  (language c)
  (names stdlib_bundle_blob)
  (extra_deps stdlib_bundle.zip)))

(rule
 (targets
  stdlib_bundle.zip
  stdlib_bundle_blob.c
  stdlib_bundle.ml
  stdlib_bundle.mli)
 (action
  (run
   sh
   %{dep:../probe.sh}
   --exec-python
   -I
   %{dep:../tools/sboa_bundle.py}
   --config
   %{dep:../toolchain/sboa.config}
   stdlib
   --name
   stdlib
   --priority
   0
   --target-system
   %{system}
   --mli
   --out
   .)))
