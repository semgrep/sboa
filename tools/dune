; The bundle tool, installed into lib/sboa/ together with sboa-bundle, the
; launcher that runs it under the CPython sboa was built against
; (applications' dune rules: (run %{bin:sboa-bundle} ...)). Its tests
; (tests/) are run with pytest.

(install
 (section lib)
 (package sboa)
 (files sboa_bundle.py))

(executable
 (name launcher)
 (public_name sboa-bundle)
 (package sboa)
 (modules launcher build_python)
 (libraries unix)
 ; inside a dune workspace the launcher runs the sboa_bundle.py next to it
 (link_deps sboa_bundle.py))

(rule
 (copy ../config/build_python.ml build_python.ml))
